{
  "name": "dialed-by-h-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild lib/safe-html.js --bundle --platform=node --format=cjs --outfile=lib/safe-html-bundle.cjs && npx @tailwindcss/cli -i ./src/input.css -o ./dist/styles.css --minify && node scripts/build-public.js && node scripts/inline-css.js public-site/index.html",
    "dev": "node --env-file-if-exists=.env.local scripts/dev-server.js",
    "build:scene": "npx esbuild assets/dbh-scene.js --bundle --minify --format=esm --outfile=assets/dbh-scene.bundle.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-source.js",
    "dev:vercel": "vercel dev"
  },
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.17.1",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@react-email/preview-server": "^5.2.8",
    "@tailwindcss/cli": "^4.1.18",
    "esbuild": "0.25.12",
    "imapflow": "^1.7.0",
    "mailparser": "^3.9.15",
    "react-email": "^5.2.8",
    "tailwindcss": "^4.1.18"
  }
}
