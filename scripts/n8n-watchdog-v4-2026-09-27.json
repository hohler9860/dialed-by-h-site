  {
   "name": "Container unhealthy?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1100,
    0
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ /unhealthy|exited|degraded/.test(String($('Coolify status').first().json.status || '')) }}",
       "rightValue": true,
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "68138adb-b6ff-4589-b88d-efc8c9f9db5a"
  },
  {
   "name": "Cooldown 30m ok?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1320,
    -160
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ (Date.now() - new Date($('Last restart').first().json.at || 0).getTime()) > 30*60*1000 }}",
       "rightValue": true,
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "19f212d7-7cb8-4df8-8098-f44a01d194bb"
  },
  {
